#!/bin/sh
# /usr/bin/quarantine-cmd
# Forced command for the IDS host's SSH key. In /etc/dropbear/authorized_keys:
#   command="/usr/bin/quarantine-cmd",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAA... ids@host
#
# Allowed: "add <ip>", "del <ip>", "list". Everything else is refused.
# Validation lives here so a compromised IDS host cannot bypass it.

set -f
set -- $SSH_ORIGINAL_COMMAND
ACTION="$1"; IP="$2"
logger -t quarantine-cmd "request: $SSH_ORIGINAL_COMMAND"

# Gateways, the IDS host, and the admin workstation can never be quarantined.
PROTECTED="192.168.8.1 192.168.9.1 192.168.10.1 192.168.20.1 192.168.50.1 192.168.50.115 192.168.20.244"

check_ip() {
  echo "$IP" | grep -Eq '^192\.168\.(8|9|10|20|50)\.[0-9]{1,3}$' || { echo "refused: outside home subnets"; exit 1; }
  LAST="${IP##*.}"
  [ "$LAST" -ge 2 ] && [ "$LAST" -le 254 ] || { echo "refused: invalid host"; exit 1; }
  for P in $PROTECTED; do
    [ "$IP" = "$P" ] && { echo "refused: protected address"; exit 1; }
  done
}

case "$ACTION" in
  add)
    check_ip
    COUNT=$(nft list set inet fw4 quarantine | grep -o 'expires' | wc -l)
    [ "$COUNT" -ge 5 ] && { echo "refused: quarantine full (5)"; exit 1; }
    nft add element inet fw4 quarantine "{ $IP }" && echo "quarantined $IP"
    ;;
  del)
    check_ip
    nft delete element inet fw4 quarantine "{ $IP }" && echo "released $IP"
    ;;
  list)
    nft list set inet fw4 quarantine
    ;;
  *)
    echo "refused"; exit 1
    ;;
esac
